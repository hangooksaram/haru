// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id        String   @id
  name      String
  tags      String[]
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  elements  Json
  duration  Float

  // 가져오기 기능은 이 3개 필드를 채우지 않는다 (별도 "템플릿 공개 관리" 기능 담당).
  price     Int?
  isActive  Boolean @map("is_active") @default(false)
  sortOrder Int?    @map("sort_order")

  drafts Draft[]

  @@map("templates")
}

model User {
  id        String    @id
  email     String?
  phone     String?
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

enum DraftStatus {
  editing
  converting
  converted
}

model Draft {
  id         String      @id @default(cuid())
  // 인증 기능이 아직 없어 users 테이블과의 관계는 연결하지 않음. 추후 인증 구현 시 FK로 연결.
  userId     String?     @map("user_id")
  templateId String      @map("template_id")
  status     DraftStatus @default(editing)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  // 시안 텍스트 전체 배열. 요소는 { name, text }이며 name은 요소 전체 이름(Creatomate modifications key).
  texts      Json        @default("[]")

  template Template     @relation(fields: [templateId], references: [id])
  photos   DraftPhoto[]

  @@map("drafts")
}

model DraftPhoto {
  id          String @id @default(cuid())
  draftId     String @map("draft_id")
  storagePath String @map("storage_path")
  position    Int
  name        String

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, name])
  @@map("draft_photos")
}
