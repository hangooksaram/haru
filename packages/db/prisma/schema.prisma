// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id        String   @id
  name      String
  tags      String[]
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  elements  Json
  duration  Float

  // 가져오기 기능은 이 3개 필드를 채우지 않는다 (별도 "템플릿 공개 관리" 기능 담당).
  price     Int?
  isActive  Boolean @default(false) @map("is_active")
  sortOrder Int?    @map("sort_order")

  drafts Draft[]
  orders Order[]

  @@map("templates")
}

model User {
  id        String    @id
  email     String?
  phone     String?
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}

enum DraftStatus {
  editing
  converting
  converted
}

model Draft {
  id         String      @id @default(cuid())
  // 인증 기능이 아직 없어 users 테이블과의 관계는 연결하지 않음. 추후 인증 구현 시 FK로 연결.
  userId     String?     @map("user_id")
  templateId String      @map("template_id")
  status     DraftStatus @default(editing)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")
  // 시안 텍스트 전체 배열. 요소는 { name, text }이며 name은 요소 전체 이름(Creatomate modifications key).
  texts      Json        @default("[]")

  template Template     @relation(fields: [templateId], references: [id])
  photos   DraftPhoto[]
  // 하나의 시안에 여러 주문이 생길 수 있다(결제완료/취소 후 재생성 등).
  // "대기" 주문은 동시에 최대 1건이라는 제약은 orders 테이블의 부분 유니크 인덱스가 강제한다.
  orders   Order[]

  @@map("drafts")
}

model DraftPhoto {
  id          String @id @default(cuid())
  draftId     String @map("draft_id")
  storagePath String @map("storage_path")
  position    Int
  name        String

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, name])
  @@map("draft_photos")
}

// 정책: 대기(pending_payment) 상태는 시안 하나당 동시에 최대 1건만 존재할 수 있다
// (orders 마이그레이션의 부분 유니크 인덱스로 강제). paid/canceled 등 종결된 주문은
// 같은 시안에 여러 건 쌓일 수 있다 (재구매, 취소 후 재생성).
enum OrderStatus {
  pending_payment
  paid
  canceled
}

// 제작 전 null → rendering → completed / failed
enum OrderRenderStatus {
  rendering
  completed
  failed
}

model Order {
  id          String      @id @default(cuid())
  userId      String?     @map("user_id")
  draftId     String      @map("draft_id")
  templateId  String      @map("template_id")
  orderNumber String      @unique @map("order_number")
  status      OrderStatus @default(pending_payment)
  // 결제 확정 금액. 주문 생성 시점의 template.price를 복사해 고정한다.
  price       Int
  // 시안 텍스트 전체 배열(JSON). 전환 시 drafts.texts를 그대로 복사하며 이후 불변.
  texts       Json        @default("[]")

  renderStatus       OrderRenderStatus? @map("render_status")
  creatomateRenderId String?            @map("creatomate_render_id")
  renderRequestedAt  DateTime?          @map("render_requested_at")
  renderAttemptCount Int                @default(0) @map("render_attempt_count")
  completedAt        DateTime?          @map("completed_at")
  finalVideoUrl      String?            @map("final_video_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  draft    Draft        @relation(fields: [draftId], references: [id])
  template Template     @relation(fields: [templateId], references: [id])
  photos   OrderPhoto[]
  payment  Payment?

  @@index([draftId])
  @@map("orders")
}

model OrderPhoto {
  id          String @id @default(cuid())
  orderId     String @map("order_id")
  storagePath String @map("storage_path")
  position    Int
  name        String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, name])
  @@map("order_photos")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model Payment {
  id      String        @id @default(cuid())
  orderId String        @unique @map("order_id")
  amount  Int
  status  PaymentStatus
  // 결제대행사. 현재는 토스페이먼츠만 지원해 항상 "tosspayments".
  pgProvider      String   @map("pg_provider")
  pgTransactionId String   @map("pg_transaction_id")
  paidAt          DateTime @map("paid_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}
